# BookOrbit MCP server configuration
#
# BookOrbit issues short-lived (15 min) JWT access tokens and has no long-lived
# API key. The server therefore logs in with your account credentials and
# refreshes / re-logs in automatically as tokens expire.

# Base URL of your BookOrbit instance (with or without a trailing slash).
BOOKORBIT_URL=https://bookorbit.example.com

# Recommended: username + password (enables automatic token refresh).
BOOKORBIT_USERNAME=your-username
BOOKORBIT_PASSWORD=your-password

# Alternative for quick local testing only: a static Bearer token.
# Expires after ~15 minutes and will NOT auto-refresh. Prefer username/password.
# BOOKORBIT_TOKEN=

# Optional: where extracted book text is cached (default: ~/.cache/bookorbit-mcp).
# CACHE_DIR=

# Optional hosted embeddings. Defaults remain local FastEmbed/BGE.
# Selecting Voyage builds a SEPARATE index; existing BGE progress is retained.
# EMBED_PROVIDER=voyage
# EMBED_MODEL=voyage-4-large
# EMBED_QUERY_MODEL=voyage-4-lite
# EMBED_DIMENSIONS=1024
# EMBED_REVISION=1
# Explicit consent: passages, queries and semantic annotations go to Voyage HTTPS.
# EMBED_ALLOW_EXTERNAL_CONTENT=1
# VOYAGE_API_KEY=
# Optional similarity cutoff, model-specific and not a relevance probability.
# Voyage default 0 returns candidates for review; BGE default remains 0.65.
# MIN_SEMANTIC_SIMILARITY=0
# PDF extraction/download size cap in MiB: default80, bounded1..128.
# PDF_MAX_MIB=128
